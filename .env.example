# Seguin Morris Recruiting Intelligence Platform — environment template
# Copy this file to .env and fill in values. NEVER commit .env.
#
# Local dev uses Railway-hosted dev databases (separate from production).
# Production values come from Railway service variables in the prod environment.

# --- Application ---
APP_ENV=development                            # development | staging | production
APP_NAME=seguin-morris-recruiting
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEFAULT_LANGUAGE=fr                        # fr | en

# --- Database ---
# For local dev: paste the DATABASE_PUBLIC_URL from your Railway dev Postgres service.
# Form: postgresql+psycopg://USER:PASS@HOST.proxy.rlwy.net:PORT/railway
# In production on Railway, this is auto-injected as DATABASE_URL (internal hostname).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@HOST.proxy.rlwy.net:PORT/railway

# --- Cache / Queue ---
# For local dev: paste the REDIS_PUBLIC_URL from your Railway dev Redis service.
# Form: redis://default:PASS@HOST.proxy.rlwy.net:PORT
REDIS_URL=redis://default:CHANGE_ME@HOST.proxy.rlwy.net:PORT
CELERY_BROKER_URL=redis://default:CHANGE_ME@HOST.proxy.rlwy.net:PORT/1
CELERY_RESULT_BACKEND=redis://default:CHANGE_ME@HOST.proxy.rlwy.net:PORT/2

# --- Security ---
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720                         # 12 hours

# --- LLM provider (swappable adapter) ---
LLM_PROVIDER=mock                              # mock | openai | anthropic | gemini | azure_openai | lm_studio
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=                                  # only for azure_openai / lm_studio

# --- Email provider (swappable adapter, Gmail v1 / M365 v2) ---
EMAIL_PROVIDER=mock                            # mock | gmail | microsoft365
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback
MICROSOFT365_CLIENT_ID=
MICROSOFT365_CLIENT_SECRET=
MICROSOFT365_TENANT_ID=

# --- Retention ---
INACTIVE_LEAD_RETENTION_DAYS=365               # 12 months per spec

# --- Frontend (consumed by Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=Seguin Morris
NEXT_PUBLIC_DEFAULT_LOCALE=fr
